# Google Gemini API Key (used as fallback, 20 requests/day on free tier)
GOOGLE_API_KEY=your_gemini_api_key_here

# Groq API Key (PRIMARY - higher quota, faster inference)
# Free tier: 30 requests/minute, 14,400 requests/day
GROQ_API_KEY=your_groq_api_key_here

# Agent Server URL (for Streamlit UI)
AGENT_SERVER_URL=http://localhost:8001

# Copilot KB API URL
COPILOT_KB_API=http://localhost:8000

# Auto-run agents on server startup
# Set to 'false' to prevent agents from consuming API quota automatically
# Set to 'true' to enable automatic 24/7 monitoring (uses API quota)
AUTO_RUN_AGENTS=false

# Tableau Configuration (for vulnerability data)
# Set USE_REAL_TABLEAU=true to fetch from live Tableau Server, false for CSV mock data
USE_REAL_TABLEAU=false
TABLEAU_SERVER=https://prod-in-a.online.tableau.com
TABLEAU_SITE_ID=your_site_id
TABLEAU_USERNAME=your_username@company.com
TABLEAU_PASSWORD=your_password
# Personal Access Token (more secure - recommended over username/password)
TABLEAU_PAT_NAME=your_pat_name
TABLEAU_PAT_VALUE=your_pat_token
# Workbook/View names (optional - auto-detects if blank)
TABLEAU_WORKBOOK_NAME=
TABLEAU_VIEW_NAME=
